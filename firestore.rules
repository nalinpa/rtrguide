rules_version = '2';

// rotoruaguide-d8274. Replaces the default test-mode rules (open read/write
// to everything, expiring 2026-10-05 to deny-all).
//
// Every write in normal app operation goes through enginev1/api's
// admin-authenticated backend (bypasses these rules entirely) — the app
// itself only ever writes directly to users/{uid} (useSavedSites.ts). So
// client write access below is deny-by-default except for that one path;
// read access matches what enginev1/api's routes actually rely on running
// under the caller's own token (itineraries.ts, reviews.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /itineraries/{itineraryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // No client reads: premium sites' paid content must only leave through
    // enginev1/api's locations route, which checks the caller's unlock and reads
    // with the service account (lib/firestore-admin.ts readLocations). Deploy
    // that api change BEFORE these rules, or the api's API-key reads 403.
    match /sites/{siteId} {
      allow read, write: if false;
    }

    match /siteReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Moderation. Unlike every other write, enginev1/api writes these two under
    // the *caller's* own id token (routes/moderation.ts), so they need explicit
    // rules — without them both silently 403'd and no report or block ever
    // reached Firestore. Reports are write-only for users: triage happens over
    // Telegram and the admin SDK, which bypasses these rules.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedByUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // GET /blocks queries blocks where blockedByUid == caller, which satisfies
    // this read rule; a broader query is rejected, as it should be.
    match /blocks/{blockId} {
      allow read: if request.auth != null
                  && resource.data.blockedByUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.blockedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
