rules_version = '2';

// rotoruaguide-d8274. Replaces the default test-mode rules (open read/write
// to everything, expiring 2026-10-05 to deny-all).
//
// Every write in normal app operation goes through enginev1/api's
// admin-authenticated backend (bypasses these rules entirely) — the app
// itself only ever writes directly to users/{uid} (useSavedSites.ts). So
// client write access below is deny-by-default except for that one path;
// read access matches what enginev1/api's routes actually rely on running
// under the caller's own token (itineraries.ts, reviews.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /itineraries/{itineraryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /sites/{siteId} {
      allow read: if true;
      allow write: if false;
    }

    match /siteReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
